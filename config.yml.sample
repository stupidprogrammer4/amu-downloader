app:
  modules:
  - src.modules
  settings: src.config.settings.DownloaderAppSettings
fastapi:
  title: AMU Downloader
  description: Independent public media downloads
  version: 0.1.0
run:
  entrypoint: src.apps.api:app
  mode: prod
  host: 0.0.0.0
  port: 8000
  workers: 1
db:
  dsn: mysql+aiomysql://downloader:replace@mysql:3306/downloader
  test_dsn: mysql+aiomysql://downloader:replace@127.0.0.1:3306/downloader_test
  pool_size: 5
  max_overflow: 5
  pool_timeout: 10
  pool_recycle: 1800
storage:
  path: data/storage
  temp_dir: data/tmp
  max_file_size: 1048576
  allowed_extensions: []
logging:
  level: INFO
  format: json
  service: downloader-api
security:
  service_key: replace
  admin_ids: []
tasks:
  url: redis://redis:6379/0
  queue_name: downloader:jobs
  schedule_prefix: downloader:schedules
  consumer_group: downloader-workers
  result_prefix: downloader:results
transport:
  dry_run: false
  gateway_url: http://bots:8080
